{
  "version": "1.0.0",
  "description": "Mapeia bibliotecas Figma do DSC para pacotes/módulos no monorepo. Atualize conforme a estrutura de imports do código evoluir.",
  "libraries": {
    "Fundamentos Visuais": {
      "import": "@dsc/foundations",
      "language": "ts",
      "docs": "https://design.caixa/foundations",
      "notes": "Tokens base (cores, tipografia, espaçamento, sombras)."
    },
    "DSC | Super App": {
      "import": "@dsc/super-app",
      "language": "ts",
      "docs": "https://design.caixa/super-app",
      "notes": "Componentes React do Super App."
    },
    "Super DSC | Web": {
      "import": "@dsc/super-gerenciador",
      "language": "ts",
      "docs": "https://design.caixa/super-gerenciador",
      "notes": "Componentes React do Super Gerenciador (Web)."
    },
    "Web Angular & React": {
      "import": "@dsc/web",
      "subpaths": {
        "angular": "@dsc/web/angular",
        "react": "@dsc/web/react"
      },
      "language": "ts",
      "docs": "https://design.caixa/web",
      "notes": "Biblioteca dual-target. Use o subpath conforme stack do projeto."
    },
    "DSC | Android": {
      "import": "com.caixa.dsc.android",
      "language": "kotlin",
      "docs": "https://design.caixa/android",
      "notes": "Componentes nativos Android (Material Design), distintos da lib mobile React Native (DSC | Super App)."
    },
    "Design Acessível": {
      "import": "@dsc/a11y",
      "language": "ts",
      "docs": "https://design.caixa/a11y",
      "notes": "Utilitários e wrappers de acessibilidade."
    },
    "Design Acessível | Super App (React Native)": {
      "import": "@dsc/a11y-mobile",
      "language": "ts",
      "docs": "https://design.caixa/a11y-mobile",
      "notes": "Utilitários e wrappers de acessibilidade para React Native (Super App)."
    }
  },
  "componentOverrides": {}
}
