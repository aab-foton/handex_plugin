{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["@figma/plugin-typings"]
  },
  "include": ["src/plugin/code.js", "src/plugin/backend/**/*.js", "src/plugin/globals.d.ts"]
}
